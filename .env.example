# ReconAI — environment variables
# Copy to .env and fill in your values

# AI analysis — set ONE of the following (priority if multiple are set:
# ANTHROPIC_API_KEY > GEMINI_API_KEY > OPENAI_API_KEY)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional — enables Shodan agent
SHODAN_API_KEY=

# Optional — enables Supabase persistence
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Optional — scope override (comma-separated CIDR or domains you own/have auth for)
# Example: AUTHORIZED_SCOPE=192.168.1.0/24,lab.mycompany.com
AUTHORIZED_SCOPE=
